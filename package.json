{
  "name": "vue-bildkonverter",
  "version": "3.0.0",
  "description": "Moderne Bildkonverter-Anwendung mit Vue 3 und i18n",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "type-check": "vue-tsc --noEmit && tsc -p tsconfig.node.json && tsc -p tsconfig.worker.json && tsc -p e2e/tsconfig.json",
    "preview": "vite preview",
    "dev:desktop": "vite --mode desktop --strictPort",
    "build:desktop": "vite build --mode desktop",
    "tauri": "tauri",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tauri-apps/plugin-http": "^2.8.3",
    "@vueuse/core": "^10.9.0",
    "canvas-confetti": "^1.9.2",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^1.0.0",
    "onnxruntime-web": "1.30.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-i18n": "^9.10.2",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.63.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/browser": "^3.2.7",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.5",
    "jiti": "^2.7.0",
    "playwright": "~1.63.0",
    "prettier": "^3.2.5",
    "sass": "^1.71.1",
    "typescript": "^5.9.3",
    "vite": "^5.1.6",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.12"
  }
}
