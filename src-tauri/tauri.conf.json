{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bildkonverter Pro",
  "mainBinaryName": "bildkonverter",
  "version": "../package.json",
  "identifier": "com.kodinitools.bildkonverter",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "KodiniTools",
    "homepage": "https://kodinitools.com/bildkonverter/",
    "copyright": "© KodiniTools",
    "category": "Photography",
    "shortDescription": "Bilder konvertieren und bearbeiten – lokal auf dem PC",
    "longDescription": "Bildkonverter Pro von KodiniTools: Bilder konvertieren, bearbeiten, komprimieren, zuschneiden und Hintergründe entfernen. Die Verarbeitung läuft lokal auf dem Rechner.",
    "license": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": ["de-DE", "en-US"]
      }
    }
  }
}
